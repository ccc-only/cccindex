<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Rental Hub</title>
  <style>
    :root { --primary: #10b981; --bg: #0f172a; --card: #1e293b; --text: #f8fafc; --danger: #ef4444; }
    body { font-family: system-ui, sans-serif; background: var(--bg); color: var(--text); padding: 20px; margin: 0; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; max-width: 1400px; margin: auto; }
    .card { background: var(--card); padding: 20px; border-radius: 12px; }
    h2, h3 { border-bottom: 2px solid var(--primary); padding-bottom: 8px; margin-top: 0; }
    label { display: block; margin: 10px 0 4px; font-size: 0.85em; opacity: 0.8; }
    input, button { width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #334155; background: #0f172a; color: white; box-sizing: border-box; }
    button { background: var(--primary); color: #000; font-weight: bold; border: none; cursor: pointer; margin-top: 10px; }
    .booking-item { background: #0f172a; padding: 12px; border-radius: 8px; margin-bottom: 12px; border-left: 4px solid #f59e0b; }
    .verified { border-left-color: #10b981; }
    .cancelled { border-left-color: #ef4444; opacity: 0.5; }
    .btn-group { display: flex; gap: 6px; margin-top: 8px; }
    .btn-group button { font-size: 0.75em; padding: 6px; margin-top: 0; }
    .btn-danger { background: var(--danger); color: white; }
    .btn-blue { background: #3b82f6; color: white; }
  </style>
</head>
<body>

  <div class="grid">
    <div class="card">
      <h2>Inventory Setup</h2>
      <form id="invForm">
        <label>Camera Model & Serial / Tag</label>
        <input type="text" id="camName" placeholder="e.g. Sony A7IV (Unit A)" required>
        <label>Hourly Rate (₱)</label>
        <input type="number" id="hourlyRate" required>
        <label>Daily Rate (₱)</label>
        <input type="number" id="dailyRate" required>
        <label>Security Deposit (₱)</label>
        <input type="number" id="depositAmt" required>
        <label>Turnaround Buffer (Minutes)</label>
        <input type="number" id="bufferMins" value="60">
        <button type="button" onclick="addCamera()">Add Unit</button>
      </form>
      <h3>Current Units</h3>
      <ul id="inventoryList" style="padding-left: 15px; font-size: 0.9em;"></ul>
    </div>

    <div class="card" style="grid-column: span 2;">
      <h2>Bookings & Payment Verification</h2>
      <div id="bookingList"></div>
    </div>

    <div class="card">
      <h2>Sales & Deposit Tracking</h2>
      <h3>Verified Gross Revenue</h3>
      <p style="font-size: 1.5em; font-weight: bold; color: var(--primary);">₱<span id="confirmedRevenue">0</span></p>
      
      <h3>Deposit Refund Tasks</h3>
      <ul id="depositTaskList" style="padding-left: 15px; font-size: 0.85em;"></ul>
    </div>
  </div>

  <script>
    let inventory = JSON.parse(localStorage.getItem('gear_inv')) || [];
    let bookings = JSON.parse(localStorage.getItem('gear_bookings')) || [];

    function sync() {
      localStorage.setItem('gear_inv', JSON.stringify(inventory));
      localStorage.setItem('gear_bookings', JSON.stringify(bookings));
      render();
    }

    function addCamera() {
      const name = document.getElementById('camName').value;
      const hourly = parseFloat(document.getElementById('hourlyRate').value);
      const daily = parseFloat(document.getElementById('dailyRate').value);
      const deposit = parseFloat(document.getElementById('depositAmt').value);
      const buffer = parseInt(document.getElementById('bufferMins').value) || 0;

      if(!name) return alert('Enter camera details.');
      inventory.push({ id: Date.now(), name, hourly, daily, deposit, buffer });
      sync();
    }

    function verifyPayment(id) {
      const b = bookings.find(x => x.id === id);
      if(b) {
        b.paymentVerified = true;
        b.status = 'Confirmed & Paid';
        sync();
      }
    }

    function cancelFalsifiedBooking(id) {
      if(confirm('Are you sure you want to cancel this booking? This will declare the payment falsified/unpaid and free up the time slot.')) {
        const b = bookings.find(x => x.id === id);
        if(b) {
          b.status = 'Cancelled (Falsified/Unpaid)';
          b.paymentVerified = false;
          sync();
        }
      }
    }

    function toggleDeposit(id) {
      const b = bookings.find(x => x.id === id);
      if(b) {
        b.depositReturned = !b.depositReturned;
        sync();
      }
    }

    function syncGCal(id) {
      const b = bookings.find(x => x.id === id);
      if(!b) return;
      const gCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent('Rental: ' + b.camName + ' - ' + b.customer)}&dates=${new Date(b.start).toISOString().replace(/-|:|\.\d\d\d/g, '')}/${new Date(b.end).toISOString().replace(/-|:|\.\d\d\d/g, '')}&details=${encodeURIComponent('Security Deposit Due for Return: ₱' + b.deposit)}`;
      window.open(gCalUrl, '_blank');
    }

    function render() {
      // Inventory list
      document.getElementById('inventoryList').innerHTML = inventory.map(i => 
        `<li><strong>${i.name}</strong> - ₱${i.hourly}/hr, ₱${i.daily}/day (Buffer: ${i.buffer} mins)</li>`
      ).join('');

      // Render Bookings
      const bookingBox = document.getElementById('bookingList');
      if(bookings.length === 0) {
        bookingBox.innerHTML = '<p>No bookings requested yet.</p>';
      } else {
        bookingBox.innerHTML = bookings.map(b => `
          <div class="booking-item ${b.paymentVerified ? 'verified' : ''} ${b.status.includes('Cancelled') ? 'cancelled' : ''}">
            <strong>${b.customer}</strong> — <em>${b.camName}</em>
            <br><small><strong>Dates:</strong> ${new Date(b.start).toLocaleString()} to ${new Date(b.end).toLocaleString()}</small>
            <br><small><strong>Rental Fee:</strong> ₱${b.price} | <strong>Deposit:</strong> ₱${b.deposit} | <strong>Status:</strong> ${b.status}</small>
            
            ${!b.status.includes('Cancelled') ? `
              <div class="btn-group">
                ${!b.paymentVerified ? `<button onclick="verifyPayment(${b.id})">Confirm Payment Received</button>` : ''}
                <button class="btn-danger" onclick="cancelFalsifiedBooking(${b.id})">Cancel (Falsified Payment)</button>
                <button class="btn-blue" onclick="syncGCal(${b.id})">Export to GCal</button>
              </div>
            ` : ''}
          </div>
        `).join('');
      }

      // Calculate Verified Revenue Only
      const confirmedTotal = bookings
        .filter(b => b.paymentVerified && !b.status.includes('Cancelled'))
        .reduce((sum, b) => sum + b.price, 0);
      
      document.getElementById('confirmedRevenue').innerText = confirmedTotal;

      // Render Security Deposit Returns
      document.getElementById('depositTaskList').innerHTML = bookings
        .filter(b => b.paymentVerified && !b.status.includes('Cancelled'))
        .map(b => `
          <li>
            <strong>${b.customer}</strong> (${b.camName}) - Refund ₱${b.deposit}
            <br><button onclick="toggleDeposit(${b.id})" style="padding: 2px 6px; width: auto; font-size:0.8em; background:${b.depositReturned ? '#10b981' : '#f59e0b'}; color:#000;">
              ${b.depositReturned ? '✓ Refunded' : 'Mark Refunded'}
            </button>
          </li>
        `).join('');
    }

    render();
  </script>
</body>
</html>
